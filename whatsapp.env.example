# Copy to whatsapp.env (git-ignored) and fill in. Never commit the real file.
DAYONE_WHATSAPP_TOKEN=paste-the-temporary-access-token
DAYONE_WHATSAPP_PHONE_ID=paste-the-test-phone-number-id
DAYONE_WHATSAPP_APP_SECRET=paste-the-app-secret
DAYONE_WHATSAPP_VERIFY_TOKEN=dayone-verify-choose-anything
# your WhatsApp number in international format without "+", mapped to the demo midwife
DAYONE_WHATSAPP_SENDERS=2126XXXXXXXX=sf-amina
# 1 = also send image crops through Meta (synthetic data only)
DAYONE_WHATSAPP_SEND_IMAGES=1
